filters:
  and:
    - file.inFolder("03_Interview")
    - file.ext == "md"
    - file.name != "AGENTS"
    - type == "event"
properties:
  file.name:
    displayName: イベント
  type:
    displayName: 種別
  company:
    displayName: 企業
  event_type:
    displayName: イベント種別
  date:
    displayName: 日時
  status:
    displayName: 状況
  next_action:
    displayName: 次アクション
  related_company:
    displayName: 関連企業
  file.mtime:
    displayName: 更新日
views:
  - type: table
    name: 選考イベント一覧
    order:
      - file.name
      - type
      - company
      - event_type
      - date
      - status
      - next_action
      - related_company
      - file.mtime
