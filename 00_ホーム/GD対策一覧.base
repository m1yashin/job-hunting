filters:
  and:
    - file.inFolder("01_選考対策/共通_GD")
    - file.ext == "md"
    - file.name != "AGENTS"
    - type == "gd_prep"
properties:
  file.name:
    displayName: ノート
  type:
    displayName: 種別
  category:
    displayName: 分類
  use_for:
    displayName: 用途
  file.mtime:
    displayName: 更新日
views:
  - type: table
    name: GDフレーム
    filters:
      and:
        - type == "gd_prep"
    order:
      - file.name
      - category
      - use_for
      - file.mtime
