filters:
  and:
    - or:
        - file.inFolder("01_選考対策/共通_面接")
        - file.inFolder("01_選考対策")
    - file.ext == "md"
    - file.name != "AGENTS"
    - or:
        - type == "interview_common_prep"
        - type == "interview_company_prep"
        - type == "motivation"
properties:
  file.name:
    displayName: ノート
  type:
    displayName: 種別
  theme:
    displayName: テーマ
  company:
    displayName: 企業
  status:
    displayName: 状況
  use_for:
    displayName: 用途
  source_notes:
    displayName: 元メモ
  source_clips:
    displayName: 原典
  related_common_notes:
    displayName: 関連共通メモ
  related_company_research:
    displayName: 関連企業研究
  file.mtime:
    displayName: 更新日
views:
  - type: table
    name: 共通メモ
    filters:
      and:
        - type == "interview_common_prep"
    order:
      - file.name
      - theme
      - use_for
      - source_notes
      - file.mtime
  - type: table
    name: 企業別面接対策
    filters:
      and:
        - type == "interview_company_prep"
    order:
      - file.name
      - company
      - status
      - use_for
      - source_clips
      - file.mtime
  - type: table
    name: 志望理由
    filters:
      and:
        - type == "motivation"
    order:
      - file.name
      - company
      - status
      - related_company_research
      - related_common_notes
      - file.mtime
