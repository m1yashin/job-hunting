  var AxolJushoSearchClass = (function(){
    var _skelton = function(ajaxUrl, $postal1, $postal2, $ken, $jusho1, errStr) {
      // define property
      this.ajaxUrl_ = ajaxUrl;
      this.$postal1_ = $postal1;
      this.$postal2_ = $postal2;
      this.$ken_ = $ken;
      this.$jusho1_ = $jusho1;
      this.errStr = errStr;
    };
    // define methods
    _skelton.prototype.jushoget = function(e){
      var _self = e.data;
      var posts = {};
      posts['yubin1'] = _self.$postal1_.val();
