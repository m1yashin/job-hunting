      onSchoolSearch: function(){
        var config = $.axolSchoolManage.config;
        var objs = $.axolSchoolManage.objs;
        var hdls = $.axolSchoolManage.hdls;
        var data = $.extend({}, config.addPosts);
        var kokushiKubun = hdls.loadKokushiKubun();
        data.kokushi = kokushiKubun.data.kokushi;
        data.kubun = kokushiKubun.data.kubun;

        if (kokushiKubun.errors.length > 0) {
          hdls.fbAlertKokushiKubun();
          alert(config.require_msg.replace('%1$s', kokushiKubun.errors.join(', ')));
          return;
        }
        data.initial = objs.search_params.initial.val();
        data.schoolken = objs.search_params.schoolken.val();
        axol.axolAjax(config.school_url, data, '', function(data){
          if (!data) { return; }
          if (data.status_str) {
            return false;
          }
          hdls.searchboxFreeze(true);
          hdls.clearAll();
          var _cnt = data.gakkeis ? data.gakkeis.length : 0;
          if (_cnt && objs.gakkei_list && objs.gakkei_list.length) {
            for (var i=0; i<_cnt; i++) {
              objs.gakkei_list.append('<option value="'+data.gakkeis[i].value+'">'+data.gakkeis[i].label+'</option>');
            }
          }
          hdls.checkGakkei(true);
          var _cnt = data.dcd.length;
          if (!_cnt || _cnt === undefined) { return; }
          var hitDcd = null;
          for (var i=0; i<_cnt; i++) {
            if (objs.preSearchValues.dcd == data.dcd[i].dcd) {
              hitDcd = data.dcd[i].dcd;
            }
            objs.d_list.append('<option value="'+data.dcd[i].dcd+'">'+data.dcd[i].dname+'</option>');
          }

          // 復元
          if (hitDcd) {
            objs.d_list.off('change', hdls.onSchoolSelect);
            objs.d_list.val(hitDcd);
            objs.d_list.trigger('change');
            objs.d_list.on('change', hdls.onSchoolSelect);

            var checkGakkei = function() {
              var hitGakkei = null;
              if (!objs.gakkei_list.length) return;
              objs.gakkei_list.children('option').each(function(el) {
                var meObj = $(this);
                if (meObj.val() == objs.preSearchValues.gakkei) {
                  hitGakkei = meObj.val();
                }
              });
              if (hitGakkei) {
                objs.gakkei_list.val(objs.preSearchValues.gakkei);
              }
            };
            $.axolSchoolManage.hdls.schoolSelectHandler(function() {
              if (objs.dbk_text_wrap.css('display') != 'none') {
                objs.d_text.val(objs.preSearchValues.dname);
                objs.b_text.val(objs.preSearchValues.bname);
                objs.k_text.val(objs.preSearchValues.kname);
                objs.d_list.off('change', hdls.onSchoolSelect);
                objs.d_list.trigger('change');
                objs.d_list.on('change', hdls.onSchoolSelect);
                checkGakkei();
                objs.preSearchValues = {};
              } else {
                var hitbcd = null;
                objs.b_list.children('option').each(function() {
                  var meObj = $(this);
                  if (meObj.val() == objs.preSearchValues.bcd) {
                    hitbcd = meObj.val();
                  }
                });
                if (hitbcd) {
                  objs.b_list.val(objs.preSearchValues.bcd)
                  $.axolSchoolManage.hdls.onBuSelect();
                  $.axolSchoolManage.hdls.buSelectHandler(function() {
                    var hitPaxcd = null;
                    objs.k_list.children('option').each(function() {
                      var meObj = $(this);
                      if (meObj.val() == objs.preSearchValues.paxcd) {
                        hitPaxcd = meObj.val();
                      }
                    });
                    if (hitPaxcd) {
                      objs.k_list.val(objs.preSearchValues.paxcd)
                    }
                    checkGakkei();
                    objs.preSearchValues = {};
                  });
                }
              }
            });
          }

        }, '', function(){
          objs.reset_btn.prop('disabled', false);
          $('.type__school').find('.fb_ownAlertStrs').css('display', '');
          $('.jsAxolSchool_gakkeiself').find('.fb_ownAlertStrs').css('display', '');
        });
      },
      onKubunSelect: function(){
        var objs = $.axolSchoolManage.objs;
        var config = $.axolSchoolManage.config;
        var kubunVal = (objs.search_params.kubun.prop("tagName") === 'SELECT')
            ? objs.search_params.kubun.val() : objs.search_params.kubun.filter(':checked').val();
        var kokushiVal = (objs.search_params.kokushi.prop("tagName") === 'SELECT')
            ? objs.search_params.kokushi.val() : objs.search_params.kokushi.filter(':checked').val();
        if (kubunVal == 1 && kokushiVal && kokushiVal != 4) {
          objs.scroll_degree.attr('role', 'radiogroup');
          objs.scroll_degree.find('.need__item strong').css('display', '');
          objs.degree_caption.css('display', 'none');
          objs.degree_caption.attr('aria-hidden', 'true');
          objs.degree_wrap.css('display', '');
          objs.degree_wrap.removeAttr('aria-hidden');
          objs.degree_wrap.find('input').each(function(){
            $(this).prop('required', true);
          });
        } else {
          objs.scroll_degree.removeAttr('role');
          objs.scroll_degree.find('.need__item strong').css('display', 'none');
          objs.degree_caption.css('display', '');
          objs.degree_caption.removeAttr('aria-hidden');
          objs.degree_wrap.css('display', 'none');
          objs.degree_wrap.attr('aria-hidden', 'true');
          objs.degree_wrap.find('input').each(function(){
            if ($(this).prop('checked')) {
              $(this).removeAttr('checked').prop('checked', false).change();
            }
            $(this).prop('required', false);
          });
