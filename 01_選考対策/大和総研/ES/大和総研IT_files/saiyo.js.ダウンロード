  //////////////////////////////////////////////////
  // Jusho foreign toggle
  $.axolJushoForeignToggle = function($kaigai, $ken, $foreigns, $jps, isRequired, isRequiredTel){
    var obj = new AxolJushoForeignToggleClass($kaigai, $ken, $foreigns, $jps, isRequired, isRequiredTel);
    obj.init(obj);
  };
  var AxolJushoForeignToggleClass = (function(){
    var _skelton = function($kaigai, $ken, $foreigns, $jps, isRequired, isRequiredTel){
      this.$kaigai_ = $kaigai;
      this.$ken_ = $ken;
      this.$foreigns_ = $foreigns;
      this.$jps_ = $jps;
      this.isRequired_ = isRequired;
      this.isRequiredTel_ = isRequiredTel;
    };

    _skelton.prototype.init = function(_self){
      _self.$kaigai_.on('change.foreignCheck', _self, _self.onCheckHdl);
      if (_self.$ken_.length) {
        _self.$ken_.on('change.foreignCheck', _self, _self.onChangeHdl);
      }
      _self.onCheckHdl({data:_self});
      _self.onChangeHdl({data:_self});
    };
    _skelton.prototype.onCheckHdl = function(e){
      var _self = e.data;
      if (_self.$ken_.length) {
        _self.$ken_.off('change.foreignCheck');
      }
      if (_self.$kaigai_.prop('checked')) {
        _self.turnForeign(_self);
        if (_self.$ken_.length) {
          _self.$ken_.prop('disabled',true).val('99').trigger('change');
        }
      } else {
        _self.turnJp(_self);
        if (_self.$ken_.length) {
          _self.$ken_.prop('disabled', false);
          if (_self.$ken_.val() == 99) {
            _self.$ken_.val('').trigger('change');
          }
        }
      }
      _self.$ken_.on('change.foreignCheck', _self, _self.onChangeHdl);
    };
    _skelton.prototype.onChangeHdl = function(e){
      var _self = e.data;
      if (_self.$ken_.val() == '99') {
        _self.$kaigai_.off('change.foreignCheck');
        _self.$ken_.prop('disabled', true);
        _self.turnForeign(_self);
        _self.$kaigai_.prop('checked', true);
        _self.$kaigai_.on('change.foreignCheck', _self, _self.onCheckHdl);
      }
    };
    _skelton.prototype.turnForeign = function(_self){
      _self.$jps_.css('display','none');
      _self.$foreigns_.css('display','flex');
      // 項目が必須の場合、国内のrequiredを外し、海外にrequiredをつける
      if (_self.isRequired_ || _self.isRequiredTel_) {
        _self.$jps_.find('span input').each(function() {
          const namealias = $(this).attr('namealias');
          const shouldRemove = (_self.isRequired_ && namealias !== 'telg' && namealias !== 'keitai') ||
              (_self.isRequiredTel_ && (namealias === 'telg' || namealias === 'keitai'));
          if (shouldRemove) {
            $(this).prop('required', false);
          }
        });
        _self.$foreigns_.find('input').each(function() {
          const name = $(this).attr('name');
          const shouldAdd = (_self.isRequired_ && name !== 'telg_kaigai' && name !== 'keitai_kaigai') ||
              (_self.isRequiredTel_ && (name === 'telg_kaigai' || name === 'keitai_kaigai'));
          if (shouldAdd) {
            $(this).prop('required', true);
          }
        });
      }
      var formItems = new axol.class.FormValuesObject(_self.$jps_);
      formItems.clearAll(true);
    };
    _skelton.prototype.turnJp = function(_self){
      _self.$jps_.css('display','flex');
      _self.$foreigns_.css('display','none');
      // 項目が必須の場合、海外のrequiredを外し、国内にrequiredをつける
      if (_self.isRequired_ || _self.isRequiredTel_) {
        _self.$jps_.find('span input').each(function() {
          const namealias = $(this).attr('namealias');
          const shouldAdd = (_self.isRequired_ && namealias !== 'telg' && namealias !== 'keitai') ||
              (_self.isRequiredTel_ && (namealias === 'telg' || namealias === 'keitai'));
          if (shouldAdd) {
            $(this).prop('required', true);
          }
        });
        _self.$foreigns_.find('input').each(function() {
          const name = $(this).attr('name');
          const shouldRemove = (_self.isRequired_ && name !== 'telg_kaigai' && name !== 'keitai_kaigai') ||
              (_self.isRequiredTel_ && (name === 'telg_kaigai' || name === 'keitai_kaigai'));
          if (shouldRemove) {
            $(this).prop('required', false);
          }
        });
      }
      var formItems = new axol.class.FormValuesObject(_self.$foreigns_);
      formItems.clearAll(true);
    };
    return _skelton;
  })();


