		$(document).ready(function() {
			(function(){
				const scrollStartEvent = new $.Event("scrollstart");
				const scrollEndEvent = new $.Event("scrollend");
				let onScroll = false;
				let scrollTimer = null;
				$(window).on('scroll.startstop', function(){
					if (!onScroll) {
						onScroll = true;
						$(window).trigger(scrollStartEvent);
					}
					if (scrollTimer) {
						clearTimeout(scrollTimer);
					}
					scrollTimer = setTimeout(function(){
						onScroll = false;
						$(window).trigger(scrollEndEvent);
					}, 1000); // 慣性スクロール最後考慮して1秒。
				});
			})();

			const $toPageTop = $('#page-top');
			$toPageTop.on('click.toPageTop', function(e){
				$('body, html').animate({scrollTop:0}, 500, 'swing');
				e.preventDefault();
				e.stopPropagation();
				return false;
			}).hide();
			const $window = $(window);
			$window.on('scrollstart.toPageTop', function() {
				$toPageTop.removeClass('onScroll').addClass('onScroll');
			}).on('scrollend.toPageTop', function(){
				if ($window.scrollTop() > 100) {
					$toPageTop.fadeIn();
				} else {
					$toPageTop.fadeOut();
				}
				$toPageTop.removeClass('onScroll');
			});
		});
	</script>


