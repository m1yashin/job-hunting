  axol.class.axolWeek = (function(){
    // weekStartDayObjは、この週の開始日時(オブジェクト作成側が、ループで持っているので、開始曜日の代わりに突っ込む。)
    var _skelton = function(weekStartDayObj, startDateObj, endDateObj, hasBefore, hasNext) {
