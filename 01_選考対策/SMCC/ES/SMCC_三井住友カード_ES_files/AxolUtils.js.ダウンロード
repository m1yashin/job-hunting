        var triangleLeft = targetLeft - triangleLeftSize - ownLeft;
        var triangleTop = this.isBottom ? -(triangleTopSize+triangleBottomSize) : ownHeight;
        if (this.isBottom) {
          this.$triangle.css({
            'border-top-color':'transparent',
