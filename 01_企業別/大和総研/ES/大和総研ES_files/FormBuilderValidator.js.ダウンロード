        var resultObj = new ValidateResult();
        if (!text) {
          var errformat = $.axolFormBuilder.getErrFormat(item['errformat'], 'FB_FileErrorFmt', defaultStrings);
          text = axol.sprintf(errformat, item['names'][target]);
